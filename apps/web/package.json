{
  "name": "datasoft-portal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit && eslint . && vitest run",
    "test": "vitest run",
    "lint": "eslint .",
    "generate:api": "openapi-typescript ../../contracts/openapi.yaml -o src/api/generated/schema.d.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "@tanstack/react-query": "^5.90.0",
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "vitest": "^3.2.0",
    "prettier": "^3.6.0",
    "openapi-typescript": "^7.10.0",
    "@types/node": "^24.0.0"
  }
}
